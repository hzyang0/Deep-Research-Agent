# 复制本文件为 .env 并填入你的配置(.env 已被 gitignore,不会泄露)

# 必填:你的 API key
OPENAI_API_KEY=sk-your-key-here

# 选填:指向 OpenAI 兼容的服务端点。
#   - 用官方 OpenAI:留空
#   - 用阿里云百炼 OpenAI 兼容模式:填百炼控制台给出的兼容模式地址
#     常见示例: https://dashscope.aliyuncs.com/compatible-mode/v1
#   - 用本地 Ollama:http://localhost:11434/v1
#   - 用其它兼容服务:填对应地址
# OPENAI_BASE_URL=

# 选填:模型分级。FAST 用于摘要等高频任务,SMART 用于规划/写作。
# FAST_MODEL=gpt-4o-mini
# SMART_MODEL=gpt-4o
